#!/bin/sh
usage() {
    echo "usage: jolt COMMAND"
    echo "  fs    full screen, hides the taskbar"
    echo "  win   window, taskbar visible"
    echo "  dm    dark mode"
    echo "  lm    light mode"
    echo "  font N  font height in pixels, 8-32 (default 16)"
    echo "  face NAME|default  fixed-width font, see jolt fonts (default Courier New)"
    echo "  fonts  list the fonts in /usr/share/fonts, bitmap ones with their sizes"
    echo "  bold on|off  draw all text in bold, for legibility"
    echo "  theme NAME  colour theme, see jolt themes (default classic)"
    echo "  themes  list the colour themes in /usr/share/themes"
    echo "  mount [CEPATH DIR]  map a CE folder into the tree, or list mounts"
    echo "  umount DIR  remove a mount"
    echo "  open FILE  open a file with its CE application"
    echo "  battery  battery and power status"
    echo "  shortcut [-s] NAME COMMAND  desktop shortcut (-s: Start menu) that runs COMMAND"
    echo "  hotkeys off|fullscreen|always  when HP hot keys run commands from /etc/hotkeys"
    echo "  keys  show the next 20 keyboard messages JoLT receives"
    echo "  latency  how long recent keystrokes took to reach the screen"
    echo "  serial-shell [DEVICE [SPEED]]  run a login shell on a serial port (default /dev/ttyS0 115200)"
    echo "  help  this help (also -h)"
    echo "Shift+PgUp/PgDn or Shift+Up/Down scroll back through output."
    echo "Ctrl+1..Ctrl+0 send F1..F10, Ctrl+- and Ctrl+= send F11 and F12."
    echo "Ctrl+Shift+F switches between full screen and windowed."
    echo "/dev/clipboard reads and writes the CE clipboard."
    echo "Settings are remembered. Type 'exit' to close JoLT."
}

command_usage() {
    echo "usage: jolt $1"
    shift
    for line in "$@"; do echo "  $line"; done
}

fail_usage() {
    command_usage "$@" >&2
    exit 1
}

sort_numbers() {
    sorted=
    for number in "$@"; do
        placed=
        result=
        for existing in $sorted; do
            if [ -z "$placed" ] && [ "$number" -lt "$existing" ]; then
                result="$result $number"
                placed=1
            fi
            result="$result $existing"
        done
        [ -z "$placed" ] && result="$result $number"
        sorted=$result
    done
}

list_fonts() {
    indent=$1
    echo "${indent}Courier New (built in, default)"
    seen=" "
    for file in /usr/share/fonts/*.ttf /usr/share/fonts/*.jbf; do
        [ -f "$file" ] || continue
        name=${file##*/}
        face=${name%%[-.]*}
        case "$seen" in *" $face "*) continue ;; esac
        seen="$seen$face "
        case "$name" in
            *.ttf) echo "$indent$face" ;;
            *)
                sizes=
                for path in /usr/share/fonts/"$face"-*.jbf; do
                    size=${path##*/}
                    size=${size#"$face"-}
                    size=${size%.jbf}
                    case "$size" in ''|*[!0-9]*) continue ;; esac
                    sizes="$sizes $size"
                done
                sort_numbers $sizes
                echo "$indent$face (bitmap:$sorted)"
                ;;
        esac
    done
}

list_themes() {
    indent=$1
    echo "${indent}classic (built in, default)"
    seen=" "
    for file in /usr/share/themes/*.conf; do
        [ -f "$file" ] || continue
        name=${file##*/}
        name=${name%.conf}
        name=${name%-dark}
        name=${name%-light}
        case "$seen" in *" $name "*) continue ;; esac
        seen="$seen$name "
        modes=
        [ -f "/usr/share/themes/$name-dark.conf" ] && modes="dark"
        [ -f "/usr/share/themes/$name-light.conf" ] && modes="${modes:+$modes and }light"
        if [ -n "$modes" ]; then echo "$indent$name ($modes)"; else echo "$indent$name"; fi
    done
}

list_mounts() {
    while read -r source target type rest; do
        [ "$type" = cefs ] && printf '%s on %s\n' "$(printf '%b' "$source")" "$target"
    done < /proc/mounts
}

battery() {
    read -r driver bios flags ac status battery_flags percent minutes units < /proc/apm
    case "$ac" in
        0x01) power="AC power" ;;
        0x00) power="battery" ;;
        *) power="unknown power source" ;;
    esac
    case "$status" in
        0x03) state=", charging" ;;
        0x01) state=", low" ;;
        0x02) state=", critical" ;;
        *) state="" ;;
    esac
    if [ "$percent" = "-1%" ]; then percent="level unknown"; fi
    remaining=""
    if [ "$minutes" != "-1" ]; then remaining=", $((minutes / 60))h $((minutes % 60))m left"; fi
    echo "$power, $percent$state$remaining"
}

osc() {
    printf '\033]7770;%s\007' "$1" > /dev/console
}

case "$1" in
    fs|full) osc fullscreen ;;
    win|window) osc window ;;
    dm|dark) osc dark ;;
    lm|light) osc light ;;
    font)
        font_help="N is the font height in pixels, 8 to 32 (default 16)"
        bitmap_help="bitmap fonts come in fixed sizes, see jolt fonts"
        case "$2" in
            ''|*[!0-9]*) fail_usage "font N" "$font_help" "$bitmap_help" ;;
        esac
        if [ "$2" -lt 8 ] || [ "$2" -gt 32 ]; then fail_usage "font N" "$font_help" "$bitmap_help"; fi
        osc "font=$2"
        ;;
    face)
        if [ $# -ne 2 ] || [ -z "$2" ] || [ ${#2} -gt 31 ]; then
            {
                command_usage "face NAME|default" "NAME is one of these fonts, default is Courier New:"
                list_fonts "    "
            } >&2
            exit 1
        fi
        osc "face=$2"
        ;;
    fonts) list_fonts ;;
    bold)
        case "$2" in
            on|off) osc "bold=$2" ;;
            *) fail_usage "bold on|off" "draw all text in bold, which can be easier to read" ;;
        esac
        ;;
    theme)
        case "$2" in
            ''|*[!A-Za-z0-9_-]*)
                {
                    command_usage "theme NAME" "NAME is one of these themes; jolt dm and jolt lm pick its dark or light version:"
                    list_themes "    "
                } >&2
                exit 1
                ;;
        esac
        osc "theme=$2"
        ;;
    themes) list_themes ;;
    mount)
        if [ $# -eq 1 ]; then list_mounts; exit 0; fi
        if [ $# -ne 3 ]; then fail_usage "mount [CEPATH DIR]" "map a CE folder at DIR, e.g. jolt mount '\\Storage Card\\Photos' /mnt/photos" "with no arguments, list the mounts"; fi
        mkdir -p "$3" && mount -t cefs "$2" "$3"
        ;;
    umount|unmount)
        if [ $# -ne 2 ]; then fail_usage "umount DIR" "remove the mount at DIR, see jolt mount"; fi
        umount "$2"
        ;;
    open)
        if [ $# -ne 2 ]; then fail_usage "open FILE" "open FILE with its CE application, e.g. jolt open letter.pwd"; fi
        if [ ! -e "$2" ]; then echo "jolt: $2: no such file" >&2; exit 1; fi
        osc "open=$(realpath "$2")"
        ;;
    battery) battery ;;
    keys) osc keys ;;
    latency) osc latency ;;
    serial-shell)
        device=${2:-/dev/ttyS0}
        speed=${3:-115200}
        stty -F "$device" "$speed" sane || exit 1
        exec script -q -c 'exec sh -l' /dev/null < "$device" > "$device" 2>&1
        ;;
    hotkeys)
        case "$2" in
            off|fullscreen|always) osc "hotkeys=$2" ;;
            *) fail_usage "hotkeys off|fullscreen|always" "when the HP hot keys run the commands in /etc/hotkeys" ;;
        esac
        ;;
    shortcut)
        place=d
        if [ "$2" = "-s" ]; then place=s; shift; fi
        if [ $# -ne 3 ]; then fail_usage "shortcut [-s] NAME COMMAND" "desktop shortcut that opens JoLT and runs COMMAND (-s: Start menu)" "e.g. jolt shortcut Laptop 'ssh user@192.168.1.10'"; fi
        case "$2" in
            ''|*[\\/:*?\"\<\>\|\;]*) echo "jolt: shortcut names cannot contain \\ / : * ? \" < > | ;" >&2; exit 1 ;;
        esac
        osc "shortcut=$place;$2;$3"
        if [ "$place" = s ]; then where="Start menu"; else where="desktop"; fi
        echo "Shortcut '$2' added to the $where"
        ;;
    help|-h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
esac
