#!/bin/sh
green='\033[1;32m'
bold='\033[1m'
reset='\033[0m'

while IFS= read -r line; do
    value=${line#*: }
    case "$line" in
        "version: "*) version=$value ;;
        "ce_version: "*) ce_version=$value ;;
        "ce_build: "*) ce_build=$value ;;
        "oem: "*) oem=$value ;;
        "device: "*) device=$value ;;
        "owner: "*) owner=$value ;;
        "display: "*) display=$value ;;
        "card_kb: "*) card_kb=$value ;;
        "card_free_kb: "*) card_free_kb=$value ;;
        "terminal: "*) terminal=$value ;;
    esac
done < /proc/jolt

while read -r name value unit; do
    case "$name" in
        MemTotal:) memory_total=$value ;;
        MemAvailable:) memory_available=$value ;;
    esac
done < /proc/meminfo

while IFS= read -r line; do
    case "$line" in
        Processor*) processor=${line#*: } ;;
        BogoMIPS*) bogomips=${line#*: } ;;
    esac
done < /proc/cpuinfo

read -r uptime rest < /proc/uptime
read -r _ _ _ ac _ _ percent _ < /proc/apm

seconds=${uptime%.*}
days=$((seconds / 86400)); hours=$((seconds % 86400 / 3600)); minutes=$((seconds % 3600 / 60))
uptime_text="${minutes}m"
[ "$hours" -gt 0 ] && uptime_text="${hours}h $uptime_text"
[ "$days" -gt 0 ] && uptime_text="${days}d $uptime_text"

case "$ac" in 0x01) power="AC" ;; 0x00) power="battery" ;; *) power="unknown" ;; esac
[ "$percent" = "-1%" ] && percent="?"

case "$oem" in
    *,*) maker=${oem%%,*}; model=${oem#*,}; model=${model# }; host="$maker ${model%%,*}" ;;
    *) host=$oem ;;
esac

applets=0
for file in /bin/*; do applets=$((applets + 1)); done
programs=0
for file in /usr/bin/*; do programs=$((programs + 1)); done

user=${owner:-${USER:-root}}
title="$user@${device:-jornada}"
underline=${title//?/-}

set -- $(stty size 2>/dev/null)
limit=$((${1:-24} - 1))
columns=${2:-80}
printed=0

row() {
    [ "$printed" -ge "$limit" ] && return
    printed=$((printed + 1))
    printf "$green%-31s$reset" "$1"
    if [ -n "$2" ]; then
        value=$3
        room=$((columns - 31 - ${#2} - 3))
        [ "${#value}" -gt "$room" ] && value=${value:0:$room}
        printf "$green$bold%s$reset: %s" "$2" "$value"
    fi
    printf '\n'
}

printf "$green%-31s$bold%s$reset\n" '                  _   _______' "$title"
printf "$green%-31s$reset%s\n" ' _______   ___   | | |__   __|' "$underline"
printed=2
row '|__    /  / _ \  | |    | |' "OS" "JoLT $version, Windows CE $ce_version.$ce_build"
row '   /  /_ | (_) | | |__  | |' "Host" "$host"
row '  /_  _/  \___/  |____| |_|' "Kernel" "armv4l $version-jolt"
row '    / /' "Uptime" "$uptime_text"
row '   //' "Packages" "$applets applets, $programs programs"
row '  /' "Shell" "ash (BusyBox)"
row '' "CPU" "${processor%% (*}, ${bogomips%.*} BogoMIPS"
row '' "Memory" "$(((memory_total - memory_available) / 1024)) MiB / $((memory_total / 1024)) MiB"
row '' "Storage" "$(((card_kb - card_free_kb) / 1024)) MiB / $((card_kb / 1024)) MiB"
row '' "Power" "$power, $percent"
row '' "Display" "${display%x*} at ${display##*x}-bit"
row '' "Terminal" "JoLT-Term $terminal, $TERM"
[ "$printed" -ge "$limit" ] && exit 0
printf '%31s' ''
for colour in 0 1 2 3 4 5 6 7; do printf '\033[4%sm   ' "$colour"; done
printf "$reset\n"
